# Required inputs (absolute paths recommended)
READS="/path/to/direct_rna.fastq.gz"   # FASTQ(.gz) or unaligned BAM
REFERENCE_FASTA="/path/to/genome.fasta"
ANNOTATION_GFF="/path/to/annotation.gff3"

# Select family loci either with a BED file or a regex matched against GFF
# attributes. FAMILY_BED takes precedence when non-empty.
FAMILY_BED=""
FAMILY_REGEX="retrotransposon hot spot.*RHS"
FEATURE_TYPE="protein_coding_gene"

RUN_NAME="example"
OUTPUT_ROOT="results"
THREADS=8

# Genome mapping mode: direct-rna-splice, splice, or no-splice.
GENOME_MAP_MODE="direct-rna-splice"
MAP_PRESET="map-ont"

# Candidate nomination: any alignment (recommended for repetitive families) or
# only primary alignments.
HIT_MODE="any"
MIN_MAPQ=0

# CD-HIT-EST clustering. Tune carefully to avoid paralogue collapse.
CLUSTER_IDENTITY=0.95
CLUSTER_LENGTH_RATIO=0.80
CLUSTER_SHORT_COVERAGE=0.80
CLUSTER_LONG_COVERAGE=0.80
CLUSTER_WORD_SIZE=10
MEMORY_MB=8000
MIN_CLUSTER_SIZE=2

# Cluster-local Racon polishing
POLISH_ROUNDS=3
POLISH_PRESET="map-ont"
