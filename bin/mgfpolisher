#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"

usage() {
    echo "Usage: mgfpolisher check CONFIG [OPTIONS]"
    echo "       mgfpolisher run CONFIG [OPTIONS]"
    echo "       mgfpolisher step STEP CONFIG [OPTIONS]"
    echo "       mgfpolisher clean CONFIG [OPTIONS]"
    echo "Options: --reads FILE --reference FILE --annotation FILE --family-bed FILE"
    echo "         --data-dir DIR --output-root DIR --run-name NAME"
    echo "         --map-mode splice|no-splice"
    echo "Relative paths use the project root, or --data-dir (relative to your current directory)."
}

cmd=${1:-}; [[ -n "$cmd" ]] || { usage; exit 2; }
case "$cmd" in
    check)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        cfg=$2; shift 2; load_config "$cfg" "$@"; "$ROOT/bin/00_check.sh"
        ;;
    run)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        cfg=$2; shift 2; load_config "$cfg" "$@"
        for step in 00 01 02 03 04 05 06; do "$ROOT/bin/${step}_"*.sh; done
        ;;
    step)
        [[ $# -ge 3 ]] || { usage; exit 2; }
        step=$2; cfg=$3; shift 3; load_config "$cfg" "$@"
        [[ "$step" =~ ^0[0-6]$ ]] || die "step must be 00 through 06"
        "$ROOT/bin/${step}_"*.sh
        ;;
    clean)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        cfg=$2; shift 2; load_config "$cfg" "$@"
        [[ -d "$RUN_DIR" ]] || die "run directory does not exist: $RUN_DIR"
        read -r -p "Remove only '$RUN_DIR'? [y/N] " answer
        [[ "$answer" == y || "$answer" == Y ]] || exit 0
        rm -rf -- "$RUN_DIR"
        ;;
    *) usage; exit 2 ;;
esac
